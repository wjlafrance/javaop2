<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!--
		Packaged macOS app. Only part of the build with -Pmac-app (see the root pom),
		so the default `./mvnw verify` neither builds nor needs jpackage.
		Depends on javaop2 and every plugin so the reactor builds them first.
	-->

	<modelVersion>4.0.0</modelVersion>
	<artifactId>dist</artifactId>
	<version>2.2.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<parent>
		<groupId>com.javaop</groupId>
		<artifactId>JavaOpParentPom</artifactId>
		<version>2.2.0-SNAPSHOT</version>
		<relativePath>../JavaOpParentPom</relativePath>
	</parent>

	<properties>
		<stage.dir>${project.build.directory}/dist</stage.dir>
		<app.dir>${project.build.directory}/app</app.dir>
		<app.name>JavaOp2</app.name>
		<!-- app-image (default) or dmg: -Dapp.type=dmg -->
		<app.type>app-image</app.type>
		<!--
			Modules for the jlink-trimmed runtime. Found with
			  jdeps -multi-release 17 -ignore-missing-deps -print-module-deps \
			    target/dist/javaop2.jar target/dist/lib/*.jar target/dist/plugins/*.jar
			java.desktop pulls in java.logging, java.prefs and the rest jlink needs.
		-->
		<app.modules>java.base,java.desktop</app.modules>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>javaop2</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Advertisements</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Alias</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>AntiFlood</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>AutoRejoin</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Autoban</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>AwayMessage</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>BNetLogin</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>BasicCommands</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>BnetEventProcess</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>BotMail</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ChannelList</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ChannelProtection</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Commands</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ConnectionCommands</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ConsoleDisplay</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Designate</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>EmailRegister</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Filters</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Forwarding</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>FunStuff</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>GlobalCommand</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Greeting</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Help</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>IPBan</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Ladder</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Logging</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Moderation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Ping</artifactId>
			<version>${project.version}</version>
