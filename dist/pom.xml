		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Profile</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ShellCommands</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>ShowInvisibleUsers</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>StayConnected</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>SweepBan</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>SwingGui</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>UserInformation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>UserManagement</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>Version</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.javaop</groupId>
			<artifactId>War3Clan</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Stage target/dist: javaop2.jar, lib/ (FlatLaf), plugins/ (every plugin jar) -->
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>stage-app-jar</id>
						<phase>package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<includeArtifactIds>javaop2</includeArtifactIds>
							<excludeTransitive>true</excludeTransitive>
							<stripVersion>true</stripVersion>
							<outputDirectory>${stage.dir}</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>stage-libs</id>
						<phase>package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<excludeGroupIds>com.javaop</excludeGroupIds>
							<includeScope>runtime</includeScope>
							<outputDirectory>${stage.dir}/lib</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>stage-plugins</id>
						<phase>package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<includeGroupIds>com.javaop</includeGroupIds>
							<excludeArtifactIds>javaop2</excludeArtifactIds>
							<excludeTransitive>true</excludeTransitive>
							<outputDirectory>${stage.dir}/plugins</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- jpackage refuses to write into an existing app -->
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<executions>
					<execution>
						<id>clean-previous-app</id>
						<phase>package</phase>
						<goals><goal>clean</goal></goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset><directory>${app.dir}</directory></fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>parse-version</id>
						<phase>initialize</phase>
						<goals><goal>parse-version</goal></goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>jpackage-app-image</id>
						<phase>package</phase>
						<goals><goal>exec</goal></goals>
						<configuration>
							<!-- the JDK running Maven must include jpackage (JDK 17+) -->
							<executable>${java.home}/bin/jpackage</executable>
							<arguments>
								<argument>--type</argument><argument>${app.type}</argument>
								<argument>--name</argument><argument>${app.name}</argument>
								<!-- jpackage wants numeric x.y.z: 2.2.0-SNAPSHOT -> 2.2.0 -->
								<argument>--app-version</argument>
								<argument>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
								<argument>--input</argument><argument>${stage.dir}</argument>
								<argument>--main-jar</argument><argument>javaop2.jar</argument>
								<argument>--main-class</argument><argument>com.javaop._main.BotStart</argument>
								<argument>--dest</argument><argument>${app.dir}</argument>
								<argument>--add-modules</argument><argument>${app.modules}</argument>
								<argument>--icon</argument><argument>${project.basedir}/../packaging/macos/JavaOp2.icns</argument>
								<argument>--mac-package-identifier</argument><argument>com.javaop.javaop2</argument>
								<argument>--mac-package-name</argument><argument>${app.name}</argument>
								<argument>--vendor</argument><argument>JavaOp2</argument>
								<argument>--description</argument><argument>JavaOp2 Battle.net bot</argument>
								<argument>--java-options</argument><argument>-Dapple.awt.application.name=${app.name}</argument>
								<argument>--java-options</argument><argument>-Xdock:name=${app.name}</argument>
								<!-- the manifest's Enable-Native-Access is ignored on a classpath launch -->
								<argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
